{
	"name": "trackswitch",
	"version": "2.0.1",
	"description": "Multitrack Audio Player",
	"keywords": [
		"audio",
		"player",
		"multitrack",
		"web-audio",
		"music",
		"waveform",
		"sheet-music",
		"synchronization",
		"react"
	],
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"author": "Nils Werner (nils.werner@audiolabs-erlangen.de)",
	"contributors": [
		"Manuel Peters (manuel.peters@audiolabs-erlangen.de)"
	],
	"homepage": "https://github.com/audiolabs/trackswitch.js",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/audiolabs/trackswitch.js.git"
	},
	"bugs": {
		"url": "https://github.com/audiolabs/trackswitch.js/issues"
	},
	"publishConfig": {
		"provenance": true
	},
	"files": [
		"dist/esm/",
		"dist/types/",
		"dist/js/trackswitch.js",
		"dist/schema/",
		"LICENSE",
		"README.md",
		"THIRD_PARTY_NOTICES.md"
	],
	"module": "dist/esm/index.js",
	"types": "dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/esm/index.js"
		},
		"./element": {
			"types": "./dist/types/element.d.ts",
			"import": "./dist/esm/element.js"
		},
		"./react": {
			"types": "./dist/types/react.d.ts",
			"import": "./dist/esm/react.js"
		},
		"./vue": {
			"types": "./dist/types/vue.d.ts",
			"import": "./dist/esm/vue.js"
		},
		"./svelte": {
			"types": "./dist/types/svelte.d.ts",
			"import": "./dist/esm/svelte.js"
		},
		"./package.json": "./package.json"
	},
	"unpkg": "dist/js/trackswitch.js",
	"jsdelivr": "dist/js/trackswitch.js",
	"peerDependencies": {
		"react": ">=18",
		"vue": ">=3"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		},
		"vue": {
			"optional": true
		}
	},
	"scripts": {
		"clean": "rimraf dist",
		"build": "npm run build:browser && npm run build:esm && npm run build:types && npm run generate",
		"postbuild": "node scripts/copy-dist-notices.mjs",
		"build:browser": "vite build --mode browser",
		"build:interactive": "npm run build:interactive-browser && npm run build:interactive-worker",
		"build:interactive-browser": "vite build --mode interactive-browser",
		"build:interactive-worker": "vite build --mode interactive-worker",
		"build:builder": "vite build --mode builder",
		"build:all": "npm run build && npm run build:interactive",
		"build:esm": "vite build --mode esm",
		"tokens:build": "node scripts/generate-css-tokens.mjs",
		"schema:build": "node scripts/generate-schema.mjs",
		"test": "tsx --test tests/*.test.ts",
		"generate": "npm run tokens:build && npm run schema:build",
		"generate:check": "npm run generate && git diff --exit-code -- src/generated docs/schema docs/_includes/css-tokens.md",
		"docs:assets": "node scripts/sync-docs-assets.mjs",
		"docs:watch": "node scripts/docs-watch.mjs",
		"docs:build": "npm run build:all && npm run build:builder && npm run docs:assets",
		"build:types": "tsc --project tsconfig.build.json",
		"prebuild": "npm run clean",
		"prepack": "npm run build",
		"typecheck": "tsc --project tsconfig.json",
		"typecheck:unused": "tsc --project tsconfig.json --noUnusedLocals --noUnusedParameters --pretty false",
		"lint": "biome check .",
		"format": "biome check --write ."
	},
	"dependencies": {
		"@tonejs/midi": "^2.0.28",
		"d3": "^7.9.0",
		"fflate": "0.8.3",
		"opensheetmusicdisplay": "^2.2.0",
		"papaparse": "^5.5.4"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.8",
		"@types/d3": "^7.4.3",
		"rimraf": "^6.1.3",
		"ts-json-schema-generator": "^2.9.0",
		"tsx": "^4.23.12",
		"typescript": "^7.0.2",
		"vite": "^8.2.1"
	}
}
